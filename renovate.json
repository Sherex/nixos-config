{
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "branchTopic": "update-flake-lock",
    "commitMessageAction": "Update flake.lock",
    "schedule": [
      "* 0 * * *" // At midnight
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["\\.nix$"],
      "matchStrings": [
        "\"(?<alias>[^\":]+):docker://(?<depName>[a-zA-Z0-9.-]+(?::[0-9]+)?(?:/[a-zA-Z0-9_.-]+)*)(?::(?<currentValue>[a-zA-Z0-9_.-]+))?(?:@(?<currentDigest>sha256:[a-f0-9]+))?\""
      ],
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": "\"{{{alias}}}:docker://{{{depName}}}{{#if newValue}}:{{{newValue}}}{{/if}}{{#if newDigest}}@{{{newDigest}}}{{/if}}\""
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchFileNames": ["**/*.nix"],
      "pinDigests": true
    }
  ]
}
